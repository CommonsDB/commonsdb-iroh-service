# Copy to `.env` (gitignored) next to the binary's working directory, or
# export the same variables in the service environment.

# Bearer key for the central CommonsDB metadata API — powers the
# "Resolve from CommonsDB API" button in registry-viewer. Without it the
# button reports that the key is not configured; everything else works.
COMMONSDB_API_KEY=zpka_your_key_here

# Override the metadata endpoint base URL if needed (default shown).
# COMMONSDB_METADATA_URL=https://api.commonsdb.org/v1/metadata/
