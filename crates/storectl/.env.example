# storectl — see docs/reader-guide.md
# End-user facing; only STORECTL_READ_TICKET is typically overridden, and
# only to point at a non-default/staging deployment. Most third-party
# users of storectl need none of this — a release build already has a
# ticket compiled in (see crates/storectl/default_ticket.txt).

STORECTL_READ_TICKET=
STORECTL_STORAGE_DIR=
STORECTL_TOP_LEVEL_PARTITIONS=256

# ISCC similarity search (`storectl similar`, docs/similarity-search.md).
# ISCC_INDEX_BANDS must match the deployment that built the index; radius
# and probe are per-query defaults, also settable via --radius / --probe.
ISCC_INDEX_BANDS=8
ISCC_SEARCH_MAX_RADIUS=16
ISCC_BAND_PROBE_RADIUS=0

LOG_LEVEL=warn
